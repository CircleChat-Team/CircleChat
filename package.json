{
  "name": "circlechat",
  "version": "1.0.0",
  "private": true,
  "description": "CircleChat 自托管轻量聊天服务器（基于 GPL-3.0 开源）",
  "main": ".output/server/index.mjs",
  "scripts": {
    "start": "PORT=${PORT:-8090} node .output/server/index.mjs",
    "build": "vite build && nitro build",
    "dev": "vite build --watch & nitro dev",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "adduser": "node --experimental-strip-types tools/adduser.ts",
    "check:i18n": "node --experimental-strip-types tools/check-i18n.ts",
    "check:actions": "node --experimental-strip-types tools/check-audit-groups.ts"
  },
  "engines": {
    "node": ">=16"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.2",
    "h3": "^2.0.1-rc.32",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "nitropack": "^2.13.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "mathjax-full": "^3.2.1",
    "mermaid": "^12.0.0",
    "svg-captcha": "^1.4.0",
    "vue-i18n": "^11.4.10"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
