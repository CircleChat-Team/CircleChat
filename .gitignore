# ============================================================
# ChatPlus / CircleChat .gitignore
# 隐私与安全原则：用户数据、密钥、环境变量、构建产物一律不进版本库
# ============================================================

# ------------------------------
# 运行时持久化数据（用户/对话数据库、上传文件）
# ------------------------------
data/
public/uploads/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------
# 备份、导出、聊天历史
# ------------------------------
backups/
backup/
export/
chat_history*
*conversation*.json
*chat*.json

# ------------------------------
# 环境变量、密钥、证书、凭据（重点安全项）
# ------------------------------
.env
.env.*
# 保留示例模板
!.env.example

# SSH私钥、证书、密钥文件
id_rsa
id_ed25519
id_dsa
id_ecdsa
*.pem
*.ppk
*.key
*.p12
*.p8
*.pfx
*_rsa
*_dsa
known_hosts
authorized_keys
.ssh/
_askpass*
*_askpass*.cmd
credentials
credentials.json
production.env

# ------------------------------
# 日志、临时、备份交换文件
# ------------------------------
*.log
*.access.log
*.tmp
*.bak
*.swp
*~

# ------------------------------
# Node 依赖
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------
# IDE / 编辑器本地配置
# ------------------------------
.idea/
.vscode/
.directory

# ------------------------------
# Nitro + Vite 构建产物 & 缓存
# ------------------------------
public/dist/
.nitro/
.output/

# ------------------------------
# CodeBuddy 本地会话记忆（插件上下文，不属于项目源码）
# ------------------------------
.codebuddy/
